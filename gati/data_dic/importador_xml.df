  LABEL "MSG Erro"
  POSITION 6
  MAX-WIDTH 4000
  VIEW-AS ""
  COLUMN-LABEL "MSG Erro"
  ORDER 50

ADD FIELD "data-hora" OF "gati-log" AS datetime 
  DESCRIPTION "Data e Hora"
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data e Hora"
  POSITION 7
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Data e Hora"
  ORDER 60

ADD FIELD "ep-codigo" OF "gati-log" AS integer 
  DESCRIPTION "Empresa"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Empresa"
  POSITION 8
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Empresa"
  ORDER 70

ADD FIELD "cod-estabel" OF "gati-log" AS character 
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Estabelecimento"
  POSITION 9
  MAX-WIDTH 6
  COLUMN-LABEL "Estab"
  ORDER 80
  MANDATORY

ADD FIELD "nsu" OF "gati-log" AS decimal 
  DESCRIPTION "Numero Sequencia Unico"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Numero Sequencial"
  POSITION 10
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "NSU"
  DECIMALS 2
  ORDER 90

ADD INDEX "ch-chave" ON "gati-log" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "chave-acesso" ASCENDING 

ADD INDEX "ch-ep-estab" ON "gati-log" 
  AREA "Schema Area"
  INDEX-FIELD "ep-codigo" ASCENDING 
