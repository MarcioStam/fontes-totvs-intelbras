ADD INDEX "ch-nsu" ON "gati-log" 
  AREA "Schema Area"
  INDEX-FIELD "nsu" ASCENDING 

ADD INDEX "ch-tag-data" ON "gati-log" 
  AREA "Schema Area"
  INDEX-FIELD "tag" ASCENDING 
  INDEX-FIELD "data-hora" ASCENDING 

