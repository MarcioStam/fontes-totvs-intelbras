ADD TABLE "gati-xml"
  AREA "Schema Area"
  DUMP-NAME "gati-xml"

ADD FIELD "chave-acesso" OF "gati-xml" AS character 
  DESCRIPTION "Chave Acesso"
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Chave Acesso"
  POSITION 2
  MAX-WIDTH 120
  VIEW-AS ""
  COLUMN-LABEL "Chave Acesso"
  ORDER 480
  MANDATORY

ADD FIELD "xml" OF "gati-xml" AS clob 
  FORMAT "x(8)"
  INITIAL ?
  POSITION 3
  LOB-AREA "Schema Area"
  LOB-BYTES 104857600
  LOB-SIZE 100M
  CLOB-CODEPAGE "iso8859-1"
  CLOB-COLLATION "basic"
  CLOB-TYPE 1
  ORDER 490

ADD FIELD "data-hora" OF "gati-xml" AS datetime 
  DESCRIPTION "Data/Hora"
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data/Hora"
  POSITION 4
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Data/Hora"
  ORDER 500

ADD FIELD "nsu" OF "gati-xml" AS decimal 
  DESCRIPTION "Numero Sequencia Unico"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Numero Sequencial"
  POSITION 5
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "NSU"
  DECIMALS 2
  ORDER 510

ADD INDEX "ch-nsu" ON "gati-xml" 
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "nsu" ASCENDING 

ADD INDEX "ch-data-hora" ON "gati-xml" 
  AREA "Schema Area"
  INDEX-FIELD "data-hora" ASCENDING 

ADD TABLE "gati-log"
  AREA "Schema Area"
  LABEL "Log de erros"
  DESCRIPTION "Log de erros de importacao de arquivos XML."
  DUMP-NAME "gati-log"

ADD FIELD "origem" OF "gati-log" AS character 
  DESCRIPTION "URL Origem"
  FORMAT "x(500)"
  INITIAL ""
  LABEL "URL Origem"
  POSITION 3
  MAX-WIDTH 1000
  VIEW-AS ""
  COLUMN-LABEL "URL Origem"
  ORDER 20

ADD FIELD "tag" OF "gati-log" AS character 
  DESCRIPTION "TAG"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "TAG"
  POSITION 4
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "TAG"
  ORDER 30

ADD FIELD "chave-acesso" OF "gati-log" AS character 
  DESCRIPTION "Chave Acesso"
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Chave Acesso"
  POSITION 5
  MAX-WIDTH 120
  VIEW-AS ""
  COLUMN-LABEL "Chave Acesso"
  ORDER 40
  MANDATORY

ADD FIELD "msg" OF "gati-log" AS character 
  DESCRIPTION "MSG Erro"
  FORMAT "x(2000)"
