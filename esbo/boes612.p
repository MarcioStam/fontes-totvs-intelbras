&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryAtivo DBOProgram 
PROCEDURE OpenQueryAtivo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK 
    WHERE {&TableName}.lativo = YES INDEXED-REPOSITION.

RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryCodModelo DBOProgram 
PROCEDURE OpenQueryCodModelo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK 
        WHERE {&TableName}.cod-modelo >= i-cod-modelo-ini
        AND   {&TableName}.cod-modelo <= i-cod-modelo-fim
        AND   {&TableName}.lativo INDEXED-REPOSITION.
    
    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE OpenQueryDescricao DBOProgram 
PROCEDURE OpenQueryDescricao :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH {&TableName} NO-LOCK 
        WHERE {&TableName}.descricao >= c-descricao-ini
        AND   {&TableName}.descricao <= c-descricao-fim
        AND   {&TableName}.lativo INDEXED-REPOSITION.
    
    RETURN "OK":U.

END PROCEDURE.

