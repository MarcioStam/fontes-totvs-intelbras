&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE SetConstraintCategoria DBOProgram 
PROCEDURE SetConstraintCategoria :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER p-nr-seq-categoria-ini   AS INT  NO-UNDO.
    DEFINE INPUT PARAMETER p-nr-seq-categoria-fim   AS INT  NO-UNDO.
    DEFINE INPUT PARAMETER p-des-categoria-ini      AS CHAR NO-UNDO.
    DEFINE INPUT PARAMETER p-des-categoria-fim      AS CHAR NO-UNDO.

    ASSIGN i-nr-seq-categoria-ini = p-nr-seq-categoria-ini 
           i-nr-seq-categoria-fim = p-nr-seq-categoria-fim 
           c-des-categoria-ini    = p-des-categoria-ini    
           c-des-categoria-fim    = p-des-categoria-fim.

    RETURN "OK":U.

END PROCEDURE.

