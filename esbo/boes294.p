&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/


    IF pType = "Create" THEN DO:

        IF CAN-FIND(bf{&TableName}
                    WHERE bf{&TableName}.fm-codigo = RowObject.fm-codigo) THEN DO:

            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="outros"
                                        &ErrorSubType="ERROR"
                                        &ErrorDescription="Este registro j† foi cadastrado no sistema."}
        END.

        RUN setRecord IN THIS-PROCEDURE (INPUT TABLE RowObject).
    END.


    IF NOT CAN-FIND(FIRST grup-estoque NO-LOCK
                    WHERE grup-estoq.ge-codigo = RowObject.ge-codigo) THEN DO:

        {method/svc/errors/inserr.i &ErrorNumber="17006"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorDescription="N∆o encontrado Grupo Estoque com o valor informado."}
    END.


    IF RowObject.acond <> 0 THEN DO:

        IF NOT CAN-FIND(FIRST c-tab-res NO-LOCK
                        WHERE c-tab-res.nr-tabela = 4
                        AND   c-tab-res.sequencia = RowObject.acond) THEN DO:
    
            {method/svc/errors/inserr.i &ErrorNumber="17006"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorDescription="N∆o encontrado Acondicionamento com o valor informado."}
            
        END.

    END.

    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

