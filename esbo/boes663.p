&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice idx-colab-conta-cor
  Parameters:  
               recebe valor do campo cod-colab
               recebe valor do campo periodo
               recebe valor do campo seq
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-colab LIKE colab-conta-cor.cod-colab NO-UNDO.
    DEFINE INPUT PARAMETER pperiodo LIKE colab-conta-cor.periodo NO-UNDO.
    DEFINE INPUT PARAMETER pseq LIKE colab-conta-cor.seq NO-UNDO.

    FIND FIRST bfcolab-conta-cor WHERE 
        bfcolab-conta-cor.cod-colab = pcod-colab AND 
        bfcolab-conta-cor.periodo = pperiodo AND 
        bfcolab-conta-cor.seq = pseq NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfcolab-conta-cor THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfcolab-conta-cor)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToColab DBOProgram 
PROCEDURE linkToColab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-handle AS HANDLE      NO-UNDO.

    RUN getKey IN p-handle (OUTPUT c-cod-colab).

    RUN setConstraintColab IN THIS-PROCEDURE (INPUT c-cod-colab).

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryColab DBOProgram 
PROCEDURE openQueryColab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName} FOR EACH  {&TableName} NO-LOCK
                                WHERE {&TableName}.cod-colab = c-cod-colab INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

