PROCEDURE linkToTabPreco :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAMETER p-bodi189 AS HANDLE      NO-UNDO.

    RUN getKey IN p-bodi189 (OUTPUT c-nr-tabpre).

    RETURN "OK":U.
END PROCEDURE.

