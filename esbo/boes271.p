&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice pagto
  Parameters:  
               recebe valor do campo nr-pagamento-invoice
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pnr-pagamento LIKE pagamento-invoice.nr-pagamento NO-UNDO.

    FIND FIRST bfpagamento-invoice WHERE 
        bfpagamento-invoice.nr-pagamento = pnr-pagamento NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfpagamento-invoice THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfpagamento-invoice)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

