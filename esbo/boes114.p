PROCEDURE getKey :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valores dos campos do °ndice codigo
  Parameters:  
               retorna valor do campo cod-tipo
               retorna valor do campo cod-depos
               retorna valor do campo localizacao
               retorna valor do campo it-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE OUTPUT PARAMETER pcod-tipo LIKE item-local.cod-tipo NO-UNDO.
    DEFINE OUTPUT PARAMETER pcod-depos LIKE item-local.cod-depos NO-UNDO.
    DEFINE OUTPUT PARAMETER plocalizacao LIKE item-local.localizacao NO-UNDO.
    DEFINE OUTPUT PARAMETER pit-codigo LIKE item-local.it-codigo NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
       RETURN "NOK":U.

    ASSIGN pcod-tipo = RowObject.cod-tipo
           pcod-depos = RowObject.cod-depos
           plocalizacao = RowObject.localizacao
           pit-codigo = RowObject.it-codigo.

    RETURN "OK":U.
END PROCEDURE.

