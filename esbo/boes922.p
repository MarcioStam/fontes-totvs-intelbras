&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice pr
  Parameters:  
               recebe valor do campo it-codigo
               recebe valor do campo cc-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pit-codigo LIKE int-item-cc.it-codigo NO-UNDO.
    DEFINE INPUT PARAMETER pcc-codigo LIKE int-item-cc.cc-codigo NO-UNDO.

 //   DEFINE INPUT PARAMETER pcod-falha LIKE item-falha.cod-falha NO-UNDO.

    FIND FIRST bfint-item-cc WHERE 
               bfint-item-cc.it-codigo = pit-codigo AND 
               bfint-item-cc.cc-codigo = pcc-codigo 
               NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfint-item-cc THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfint-item-cc)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

