&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE AfterNewRecord DBOProgram 
PROCEDURE AfterNewRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    FIND LAST bfConteudo-programa NO-LOCK
        WHERE bfConteudo-programa.cod-programa = RowObject.cod-programa NO-ERROR.
    IF AVAIL bfConteudo-programa THEN
        ASSIGN RowObject.sequencia = bfConteudo-programa.sequencia + 1.
    ELSE 
        ASSIGN RowObject.sequencia = 1.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE BeforeCreateRecord DBOProgram 
PROCEDURE BeforeCreateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE iLastSeq AS INTEGER      NO-UNDO.

    IF CAN-FIND(bfConteudo-Programa NO-LOCK WHERE bfConteudo-Programa.cod-programa = RowObject.cod-programa
                                            AND   bfConteudo-programa.sequencia    = RowObject.sequencia) THEN DO:

        FIND LAST bfConteudo-programa NO-LOCK 
            WHERE bfConteudo-programa.cod-programa = RowObject.cod-programa NO-ERROR.
        IF AVAILABLE bfConteudo-programa THEN
            ASSIGN iLastSeq = bfConteudo-programa.sequencia + 1.
        ELSE
            ASSIGN iLastSeq = 1.

        IF NOT SESSION:BATCH-MODE THEN
            MESSAGE 'A Sequencia do Conteudo do Programa ser† criada com o n£mero' iLastSeq
                    ' pois j† existe uma sequància com o n£mero' RowObject.sequencia
                VIEW-AS ALERT-BOX INFORMATION TITLE 'Nova sequància do Conteudo do Programa'.

        ASSIGN RowObject.sequencia = iLastSeq.
    END.

    RUN setConstraintMain IN THIS-PROCEDURE.

END PROCEDURE.

