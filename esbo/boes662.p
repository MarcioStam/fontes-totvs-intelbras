&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF  pType = "Create" THEN DO:
        IF  NOT CAN-FIND(FIRST usuar_mestre NO-LOCK
                         WHERE usuar_mestre.cod_usuario = rowObject.cod-colab) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="'Colaborador'"}
        END.

        IF  NOT CAN-FIND(FIRST mov-comis NO-LOCK
                         WHERE mov-comis.cod-mov = rowObject.cod-mov) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="2"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="'Movimento'"}
        END.

        IF  rowObject.dt-movto = ? THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="17386"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="'Data Movimento'"}
        END.

        IF  CAN-FIND(FIRST colab-deb-cred-final NO-LOCK
                     WHERE colab-deb-cred-final.cod-colab = rowObject.cod-colab
                     AND   colab-deb-cred-final.cod-mov   = rowObject.cod-mov
                     AND   colab-deb-cred-final.dt-movto  = rowObject.dt-movto) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber="8"
                                        &ErrorType="EMS"
                                        &ErrorSubType="ERROR"
                                        &ErrorParameters="'DÇbito/CrÇdito Final'"}
        END.
    END.

    IF  rowObject.valor = 0 THEN DO:
        {method/svc/errors/inserr.i &ErrorNumber="17386"
                                    &ErrorType="EMS"
                                    &ErrorSubType="ERROR"
                                    &ErrorParameters="'Valor'"}
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

