&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice idx-colab-deb-cred-final
  Parameters:  
               recebe valor do campo cod-colab
               recebe valor do campo cod-mov
               recebe valor do campo dt-movto
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-colab LIKE colab-deb-cred-final.cod-colab NO-UNDO.
    DEFINE INPUT PARAMETER pcod-mov   LIKE colab-deb-cred-final.cod-mov   NO-UNDO.
    DEFINE INPUT PARAMETER pdt-movto  LIKE colab-deb-cred-final.dt-movto  NO-UNDO.

    FIND FIRST bfcolab-deb-cred-final WHERE 
        bfcolab-deb-cred-final.cod-colab = pcod-colab AND 
        bfcolab-deb-cred-final.cod-mov   = pcod-mov AND 
        bfcolab-deb-cred-final.dt-movto  = pdt-movto NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfcolab-deb-cred-final THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfcolab-deb-cred-final)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToColab DBOProgram 
PROCEDURE linkToColab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT  PARAMETER p-handle AS HANDLE      NO-UNDO.

    RUN getKey IN p-handle (OUTPUT c-cod-colab).

    RUN setConstraintColab IN THIS-PROCEDURE (INPUT c-cod-colab).

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryColab DBOProgram 
PROCEDURE openQueryColab :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    OPEN QUERY {&QueryName} FOR EACH  {&TableName} NO-LOCK
                                WHERE {&TableName}.cod-colab = c-cod-colab INDEXED-REPOSITION.

    RETURN "OK":U.
END PROCEDURE.

