&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE SetConstraintSequencia DBOProgram 
PROCEDURE SetConstraintSequencia :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAM p-periodo-ini  LIKE faturamento.periodo  NO-UNDO.
    DEFINE INPUT PARAM p-periodo-fim  LIKE faturamento.periodo  NO-UNDO.
    DEFINE INPUT PARAM p-unid-neg-ini LIKE faturamento.unid-neg NO-UNDO.
    DEFINE INPUT PARAM p-unid-neg-fim LIKE faturamento.unid-neg NO-UNDO.
    DEFINE INPUT PARAM p-segmento-ini LIKE faturamento.segmento NO-UNDO.
    DEFINE INPUT PARAM p-segmento-fim LIKE faturamento.segmento NO-UNDO.
    
    ASSIGN v-periodo-ini  = p-periodo-ini
           v-periodo-fim  = p-periodo-fim
           v-unid-neg-ini = p-unid-neg-ini
           v-unid-neg-fim = p-unid-neg-fim
           v-segmento-ini = p-segmento-ini
           v-segmento-fim = p-segmento-fim.
    
END PROCEDURE.

