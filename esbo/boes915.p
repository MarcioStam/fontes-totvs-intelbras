&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice idx_pri
  Parameters:  
               recebe valor do campo periodo
               recebe valor do campo unid-neg
               recebe valor do campo segmento
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pperiodo     LIKE faturamento.periodo     NO-UNDO.
    DEFINE INPUT PARAMETER psegmento    LIKE faturamento.segmento    NO-UNDO.
    DEFINE INPUT PARAMETER pmercado     LIKE faturamento.mercado     NO-UNDO.
    DEFINE INPUT PARAMETER punid-neg    LIKE faturamento.unid-neg    NO-UNDO.
    DEFINE INPUT PARAMETER pvl-cart     LIKE faturamento.vl-cart     NO-UNDO.
    DEFINE INPUT PARAMETER pvl-fat-orc  LIKE faturamento.vl-fat-orc  NO-UNDO.
    DEFINE INPUT PARAMETER pvl-fat-real LIKE faturamento.vl-fat-real NO-UNDO. 
    DEFINE INPUT PARAMETER pvl-pendente LIKE faturamento.vl-pendente NO-UNDO.
    
    FIND FIRST bffaturamento NO-LOCK
        WHERE bffaturamento.periodo     = pperiodo
          AND bffaturamento.segmento    = psegmento
          AND bffaturamento.mercado     = pmercado                  
          AND bffaturamento.unid-neg    = punid-neg             
          AND bffaturamento.vl-cart     = pvl-cart              
          AND bffaturamento.vl-fat-orc  = pvl-fat-orc           
          AND bffaturamento.vl-fat-real = pvl-fat-real          
          AND bffaturamento.vl-pendente = pvl-pendente NO-ERROR.
    
    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bffaturamento THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bffaturamento)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

