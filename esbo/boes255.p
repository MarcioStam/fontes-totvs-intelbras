&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice cli-difer
  Parameters:  
               recebe valor do campo cod-emitente
               recebe valor do campo cc-codigo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-emitente LIKE cli-difer.cod-emitente NO-UNDO.
    DEFINE INPUT PARAMETER pcc-codigo LIKE cli-difer.cc-codigo NO-UNDO.

    FIND FIRST bfcli-difer WHERE 
        bfcli-difer.cod-emitente = pcod-emitente AND 
        bfcli-difer.cc-codigo    = pcc-codigo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfcli-difer THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfcli-difer)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

