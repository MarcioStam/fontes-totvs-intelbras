&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE afternewrecord DBOProgram 
PROCEDURE afternewrecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    FIND LAST bf{&TableName} NO-LOCK NO-ERROR.
    IF AVAIL bf{&TableName} THEN
        ASSIGN RowObject.cod-campanha = bf{&TableName}.cod-campanha + 1.
    ELSE 
        ASSIGN RowObject.cod-campanha = 1.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE BeforeDeleteRecord DBOProgram 
PROCEDURE BeforeDeleteRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

FOR EACH int-campanha-item
    WHERE int-campanha-item.cod-campanha = RowObject.cod-campanha:
    DELETE int-campanha-item.
END.


END PROCEDURE.

