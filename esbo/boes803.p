&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF pType = "Create":U OR pType = "Update":U THEN DO:

        IF RowObject.it-codigo = "":U THEN
            {method/svc/errors/inserr.i
                        &ErrorNumber="2"
                        &ErrorType="Outros"
                        &ErrorSubType="ERROR"
                        &ErrorDescription="Item Inv†lido"
                        &ErrorHelp="O Item deve ser diferente de branco"}
        ELSE DO:
            IF NOT CAN-FIND(FIRST item
                            WHERE item.it-codigo = RowObject.it-codigo) THEN
                {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="Outros"
                            &ErrorSubType="ERROR"
                            &ErrorDescription="Item Inv†lido"
                            &ErrorHelp="O Item informado n∆o existe"}
                            
            IF CAN-FIND(FIRST bf{&TableName}
                        WHERE bf{&TableName}.cod-campanha = RowObject.cod-campanha
                        AND   bf{&TableName}.it-codigo    = RowObject.it-codigo) THEN
                {method/svc/errors/inserr.i
                            &ErrorNumber="2"
                            &ErrorType="Outros"
                            &ErrorSubType="ERROR"
                            &ErrorDescription="Item Inv†lido"
                            &ErrorHelp="O Item informado j† existe"}
        END.
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

