&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice cod-seq
  Parameters:  
               recebe valor do campo cod-programa
               recebe valor do campo sequencia
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-campanha LIKE {&TableName}.cod-campanha NO-UNDO.
    DEFINE INPUT PARAMETER pit-codigo    LIKE {&TableName}.it-codigo    NO-UNDO.

    FIND FIRST bf{&TableName}
        WHERE bf{&TableName}.cod-campanha = pcod-campanha
        AND   bf{&TableName}.it-codigo    = pit-codigo NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bf{&TableName} THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bf{&TableName})).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToCampanha DBOProgram 
PROCEDURE linkToCampanha :
/*---------------------------------------------------------------
  Purpose:     Recebe handle do DBO Item e execute mÇtodo getKey
  Parameters:  recebe handle de um DBO
  Notes:       
----------------------------------------------------------------*/
   DEFINE INPUT PARAMETER pHandle AS HANDLE NO-UNDO.
   
   RUN getKey IN pHandle (OUTPUT icod-campanha).
   
   RUN setConstraintCampanha IN THIS-PROCEDURE (INPUT icod-campanha).
   
   RETURN "OK":U.

END PROCEDURE.

