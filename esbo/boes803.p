&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE AfterNewRecord DBOProgram 
PROCEDURE AfterNewRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    FIND LAST bf{&TableName} NO-LOCK
        WHERE bf{&TableName}.cod-campanha = RowObject.cod-campanha NO-ERROR.
    IF AVAIL bf{&TableName} THEN
        ASSIGN RowObject.sequencia = bf{&TableName}.sequencia + 1.
    ELSE 
        ASSIGN RowObject.sequencia = 1.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE BeforeCreateRecord DBOProgram 
PROCEDURE BeforeCreateRecord :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE VARIABLE iLastSeq AS INTEGER      NO-UNDO.

    IF CAN-FIND(FIRST bf{&TableName} NO-LOCK
                WHERE bf{&TableName}.cod-campanha = RowObject.cod-campanha
                AND   bf{&TableName}.sequencia    = RowObject.sequencia) THEN DO:

        FIND LAST bf{&TableName} NO-LOCK 
            WHERE bf{&TableName}.cod-campanha = RowObject.cod-campanha NO-ERROR.

        IF AVAILABLE bf{&TableName} THEN
            ASSIGN iLastSeq = bf{&TableName}.sequencia + 1.
        ELSE
            ASSIGN iLastSeq = 1.

        IF NOT SESSION:BATCH-MODE THEN
            RUN utp/ut-msgs.p (INPUT "SHOW",
                               INPUT 27979,
                               INPUT "Nova sequància do Item da Campanha~~A Sequància do Item da Campanha ser† criada com o n£mero" + STRING(iLastSeq) + ", pois j† existe uma sequància com o n£mero" + STRING(RowObject.sequencia) + ".").

        ASSIGN RowObject.sequencia = iLastSeq.
    END.

    RUN setConstraintMain IN THIS-PROCEDURE.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE getCharField DBOProgram 
PROCEDURE getCharField :
/*------------------------------------------------------------------------------
  Purpose:     Retorna valor de campos do tipo caracter
  Parameters:  
               recebe nome do campo
               retorna valor do campo
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pFieldName AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pFieldValue AS CHARACTER NO-UNDO.

    /*--- Verifica se temptable RowObject est† dispon°vel, caso n∆o esteja ser†
          retornada flag "NOK":U ---*/
    IF NOT AVAILABLE RowObject THEN 
        RETURN "NOK":U.

    CASE pFieldName:
        WHEN "it-codigo":U THEN ASSIGN pFieldValue = RowObject.it-codigo.
        OTHERWISE RETURN "NOK":U.
    END CASE.

    RETURN "OK":U.
END PROCEDURE.

