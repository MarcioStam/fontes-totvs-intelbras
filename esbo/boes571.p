&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    IF  pType = "Create":U THEN DO:
        IF  NOT CAN-FIND(FIRST estabelec NO-LOCK
                         WHERE estabelec.cod-estabel = rowObject.cod-estabel) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber     = 56
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'Estabelecimento'"}
        END.

        IF  NOT CAN-FIND(FIRST serie NO-LOCK
                         WHERE serie.serie = rowObject.serie) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber     = 56
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'SÇrie'"}
        END.

        IF  CAN-FIND(FIRST impressora-padrao NO-LOCK
                     WHERE impressora-padrao.cod-estabel = rowObject.cod-estabel
                     AND   impressora-padrao.serie       = rowObject.serie) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber     = 7
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'Impressora Padr∆o'"}
        END.
    END.

    IF  pType = "Create":U OR pType = "Update":U THEN DO:
        IF  rowObject.impressora = "" THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber     = 265
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'Impressora'"}
        END.
    END.

    IF  pType = "Delete":U THEN DO:
        IF  CAN-FIND(FIRST usuario-impressora NO-LOCK
                     WHERE usuario-impressora.cod-estabel = rowObject.cod-estabel
                     AND   usuario-impressora.serie       = rowObject.serie) THEN DO:
            {method/svc/errors/inserr.i &ErrorNumber     = 17006
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'Impressora Padr∆o n∆o pode ser eliminada!~~Impressora Padr∆o n∆o pode ser eliminada pois possui relacionamentos com Usu†rios (Exceá‰es).'"}
        END.
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

