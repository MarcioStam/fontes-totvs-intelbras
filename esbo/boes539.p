&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.
    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/
    IF pType = "CREATE" OR pType = "UPDATE" THEN DO:
        IF rowobject.localidade = "" THEN DO:
            {METHOD/svc/errors/inserr.i
                            &Errornumber="17677"
                            &errortype="EMS"
                            &errorsubtype="ERROR"
                            &errorParameters="'Localidade'"}
        END.
        ELSE DO:
            FIND FIRST mgcad.cidade 
                WHERE mgcad.cidade.cidade = rowobject.localidade NO-LOCK NO-ERROR.

            IF NOT AVAIL cidade THEN DO:
                {METHOD/svc/errors/inserr.i
                                &Errornumber="2"
                                &errortype="EMS"
                                &errorsubtype="ERROR"
                                &errorParameters="'Localidade'"}
            END.
        END.

        IF rowobject.ibge = 0 THEN DO:
            {METHOD/svc/errors/inserr.i
                            &Errornumber="27979"
                            &errortype="EMS"
                            &errorsubtype="warning"
                            &errorParameters="'Campo com o n£mero do IBGE n∆o est† preenchido~~~~ê aconselh†vel preencher o campo com o n£mero do IBGE'"}
        END.

        IF rowobject.uf = "" THEN DO:
            {METHOD/svc/errors/inserr.i
                            &Errornumber="17677"
                            &errortype="EMS"
                            &errorsubtype="ERROR"
                            &errorParameters="'Estado'"}
        END.
    END.
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

