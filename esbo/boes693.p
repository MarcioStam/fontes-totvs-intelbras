&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram  
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ch-pr
  Parameters:  
               recebe valor do campo n-serie
               recebe valor do campo n-serie-sec
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pn-serie LIKE num-serie-fornec.n-serie NO-UNDO.
    DEFINE INPUT PARAMETER pn-serie-sec LIKE num-serie-fornec.n-serie-sec NO-UNDO.

    FIND FIRST bfnum-serie-fornec WHERE 
        bfnum-serie-fornec.n-serie = pn-serie AND 
        bfnum-serie-fornec.n-serie-sec = pn-serie-sec NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bfnum-serie-fornec THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bfnum-serie-fornec)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE VerificaNumRelsDispon DBOProgram 
PROCEDURE VerificaNumRelsDispon :
/*:T------------------------------------------------------------------------------
  Purpose:     
  Parameters:  
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER p-num-serie AS CHAR  NO-UNDO.
    DEFINE OUTPUT PARAMETER p-nr-rels   AS INT NO-UNDO.


    ASSIGN p-nr-rels = 0.

    FOR FIRST num-serie NO-LOCK
        WHERE num-serie.n-serie = p-num-serie:

        FOR FIRST item-ean NO-LOCK
            WHERE item-ean.it-codigo = num-serie.it-codigo:

            ASSIGN p-nr-rels = item-ean.int-1.

            FOR EACH b-num-serie-fornec NO-LOCK
                WHERE b-num-serie-fornec.n-serie = p-num-serie:

                ASSIGN p-nr-rels = p-nr-rels - 1.

            END.

            IF p-nr-rels < 0 THEN
                ASSIGN p-nr-rels = 0.

        END.

    END.

    RETURN "OK":U.

END PROCEDURE.

