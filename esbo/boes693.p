&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE validateRecord DBOProgram 
PROCEDURE validateRecord :
/*:T------------------------------------------------------------------------------
  Purpose:     Validaá‰es pertinentes ao DBO
  Parameters:  recebe o tipo de validaá∆o (Create, Delete, Update)
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT PARAMETER pType AS CHARACTER NO-UNDO.

    DEFINE VARIABLE i-nr-imeis AS INTEGER     NO-UNDO.

    
    /*:T--- Utilize o parÉmetro pType para identificar quais as validaá‰es a serem
          executadas ---*/
    /*:T--- Os valores poss°veis para o parÉmetro s∆o: Create, Delete e Update ---*/
    /*:T--- Devem ser tratados erros PROGRESS e erros do Produto, atravÇs do 
          include: method/svc/errors/inserr.i ---*/
    /*:T--- Inclua aqui as validaá‰es ---*/

    IF  pType = "Create":U THEN DO:

        IF CAN-FIND(FIRST b-num-serie-fornec
                    WHERE b-num-serie-fornec.n-serie = RowObject.n-serie
                    AND   b-num-serie-fornec.n-serie-sec = RowObject.n-serie-sec) THEN DO:

            {method/svc/errors/inserr.i &ErrorNumber     = 7
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'IMEI Relacionado.'"}

        END.

        ASSIGN i-nr-imeis = 0.

        FOR EACH b-num-serie-fornec NO-LOCK
            WHERE b-num-serie-fornec.n-serie = RowObject.n-serie:

            ASSIGN i-nr-imeis = i-nr-imeis + 1.

        END.

        FOR FIRST num-serie NO-LOCK
            WHERE num-serie.n-serie = RowObject.n-serie:

            FOR FIRST item-ean NO-LOCK
                WHERE item-ean.it-codigo = num-serie.it-codigo:

                IF item-ean.int-1 < i-nr-imeis + 1 THEN DO:

                    {method/svc/errors/inserr.i &ErrorNumber     = 17006
                                                &ErrorType       = "EMS"
                                                &ErrorParameters = "'N£meros de IMEIs excedeu o limite de N£meros de IMEIs Relacionados ao N£mero de SÇrie. Verifique o cadastro ESCPP020.'"}

                END.

            END.

            IF NOT AVAIL item-ean THEN DO:

                {method/svc/errors/inserr.i &ErrorNumber     = 17006
                                            &ErrorType       = "EMS"
                                            &ErrorParameters = "'Item sem dados para Etiqueta doo Produto. Cadastrar no ESCPP020.'"}

            END.

        END.

        IF NOT AVAIL num-serie THEN DO:

            {method/svc/errors/inserr.i &ErrorNumber     = 17006
                                        &ErrorType       = "EMS"
                                        &ErrorParameters = "'N£mero de SÇrie n∆o encontrado.'"}

        END.
        
    END.
    
    /*:T--- Verifica ocorrància de erros ---*/
    IF CAN-FIND(FIRST RowErrors WHERE RowErrors.ErrorSubType = "ERROR":U) THEN
        RETURN "NOK":U.
    
    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

