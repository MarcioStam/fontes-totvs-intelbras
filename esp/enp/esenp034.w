&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-estabelec w-relat 
PROCEDURE pi-estabelec :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
def input parameter p-cod-estabel as char no-undo.

for first estabelec fields(cod-estabel nome)
    where estabelec.cod-estabel = p-cod-estabel
          no-lock: end.

if not avail estabelec
then return "NOK".

create tt-digita.
assign tt-digita.cod-estabel = estabelec.cod-estabel
       tt-digita.nome        = trim(estabelec.nome).
find current tt-digita no-error.
release tt-digita.

return "OK".

END PROCEDURE.

