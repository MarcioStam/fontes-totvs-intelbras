procedure pi-procedimento-13:
    form tt-item-uni-estab.cod-estabel format "x(4)"  column-label "Estab"
         tt-item-uni-estab.it-codigo   format "x(16)" column-label "Item"
         tt-item-uni-estab.desc-item   format "x(60)" column-label "Descri‡Æo"
         tt-item-uni-estab.nr-linha    format ">>9"   column-label "Lin"
         tt-item-uni-estab.observacao  format "x(20)" column-label "Observa‡Æo"
         with width 132 down no-box stream-io frame f-13.

    empty temp-table tt-item-uni-estab.

    assign i-cont         = 0
           c-arquivo      = tt-param.diretorio + "item-x-atributos.txt"
           c-titulo-relat = "Opera‡äes sem atributos no SMD/Injetoras".

    if valid-handle(h-acomp)
    then do:
         run pi-seta-titulo in h-acomp (input "Oper sem atributos SMD/Injetoras...").
         run pi-acompanhar  in h-acomp (input 0).
    end.

    output stream st-relat to value(c-arquivo) paged page-size 64 convert target "iso8859-1".

    view stream st-relat frame f-cabec-132.
    view stream st-relat frame f-rodape-132.

    run pi-carrega-it-est (input "SMD").
    run pi-carrega-it-est (input "INJ").

    for each tt-item-uni-estab:
        assign i-cont = i-cont + 1.

        if  i-cont mod 15 = 0
        and valid-handle(h-acomp)
        then run pi-acompanhar in h-acomp (input i-cont).

        disp stream st-relat
             tt-item-uni-estab.cod-estabel
             tt-item-uni-estab.it-codigo  
             tt-item-uni-estab.desc-item  
             tt-item-uni-estab.nr-linha
             tt-item-uni-estab.observacao
             with frame f-13.
        down stream st-relat with frame f-13.
    end. /* for each tt-item-uni-estab */

    output stream st-relat close.

    if valid-handle(h-wprog)
    then run OpenDocument in h-wprog (input c-arquivo). 

    return "OK".
end procedure. /* procedure pi-procedimento-13 */
