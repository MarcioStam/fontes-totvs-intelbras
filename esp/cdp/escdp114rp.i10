procedure pi-procedimento-10:
    form item.it-codigo        format "x(16)"    column-label "Item"
         operacao.op-codigo    format ">>>>9"    column-label "Oper"
         operacao.descricao    format "x(34)"    column-label "Descri‡Æo"
         operacao.gm-codigo    format "x(9)"     column-label "Grupo Maq"
         operacao.tempo-homem  format ">>>9.999" column-label "Tmp Hom"
         operacao.tempo-maquin format ">>>9.999" column-label "Tmp Maq"
         with width 132 down no-box stream-io frame f-10.

    assign i-cont         = 0
           c-arquivo      = tt-param.diretorio + "operacoes-com-tempo-zerado.txt"
           c-titulo-relat = "Opera‡äes com tempo zerado".

    if valid-handle(h-acomp)
    then do:
         run pi-seta-titulo in h-acomp (input "Opera‡äes com tempo zerado...").
         run pi-acompanhar  in h-acomp (input 0).
    end.

    output stream st-relat to value(c-arquivo) paged page-size 64 convert target "iso8859-1".

    view stream st-relat frame f-cabec-132.
    view stream st-relat frame f-rodape-132.

    for each operacao no-lock
       where operacao.it-codigo <> ""
         and operacao.tipo-oper = 1,
       first item fields(it-codigo) no-lock
       where item.it-codigo    = operacao.it-codigo
         and item.cod-obsoleto < 3:
         assign i-cont = i-cont + 1.

         if operacao.data-termino < today
         then next.
         
         if  i-cont mod 15 = 0
         and valid-handle(h-acomp)
         then run pi-acompanhar in h-acomp (input i-cont).

         if  operacao.tempo-maquin > 0
         and operacao.tempo-homem  > 0
         then next.

         disp stream st-relat
              item.it-codigo
              operacao.op-codigo
              operacao.descricao
              operacao.gm-codigo
              operacao.tempo-homem
              operacao.tempo-maquin
              with frame f-10.
         down stream st-relat with frame f-10.
    end. /* for each operacao */

    output stream st-relat close.

    if valid-handle(h-wprog)
    then run OpenDocument in h-wprog (input c-arquivo). 

    return "OK".
end procedure. /* procedure pi-procedimento-10 */
