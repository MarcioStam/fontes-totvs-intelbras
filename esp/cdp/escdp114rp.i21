procedure pi-procedimento-21:
    def var lg-considera as logi no-undo.

    def buffer b-operacao     for operacao.
    def buffer b-grup-maquina for grup-maquina.
    
    form item.it-codigo       format "x(16)" column-label "Item"
         item.desc-item       format "x(60)" column-label "Descri‡Æo Item"
         operacao.op-codigo   format ">>>>9" column-label "Oper"
         operacao.descricao   format "x(34)" column-label "Descri‡Æo Oper"
         operacao.gm-codigo   format "x(9)"  column-label "Grupo Maq"
         with width 132 down no-box stream-io frame f-21.

    assign i-cont          = 0
           c-arquivo       = tt-param.diretorio + "uma-oper-gm-infinitos.txt"
           c-titulo-relat  = "Itens c/ apenas 1 Oper em GMs infinitos".

    if valid-handle(h-acomp)
    then do:
         run pi-seta-titulo in h-acomp (input "Uma Oper GMs infinitos...").
         run pi-acompanhar  in h-acomp (input 0).
    end.

    output stream st-relat to value(c-arquivo) paged page-size 64 convert target "iso8859-1".
    
    view stream st-relat frame f-cabec-132.
    view stream st-relat frame f-rodape-132.

    for each operacao fields(it-codigo    op-codigo gm-codigo 
                             data-termino descricao tipo) use-index codigo no-lock
       where operacao.it-codigo    <> ""
         and operacao.data-termino >= today
         and operacao.tipo          = 1 /* Interna */ ,
       first grup-maquina fields(gm-codigo log-principal) no-lock
       where grup-maquina.gm-codigo     = operacao.gm-codigo
         and grup-maquina.log-principal = no,      
       first item fields(it-codigo desc-item) no-lock
       where item.it-codigo    = operacao.it-codigo
         and item.cod-obsoleto = 1 /* Ativo */ 
             break by operacao.it-codigo:
        assign i-cont = i-cont + 1.

        if  valid-handle(h-acomp)
        and i-cont mod 10 = 0
        then run pi-acompanhar in h-acomp (input i-cont).

        if first-of(operacao.it-codigo)
        then do:
             assign lg-considera = yes.

             for each b-operacao fields(it-codigo gm-codigo data-termino tipo) no-lock
                where b-operacao.it-codigo     = operacao.it-codigo
                  and b-operacao.data-termino >= today
                  and b-operacao.tipo          = 1 /* Interna */ ,
                first b-grup-maquina fields(gm-codigo log-principal) no-lock
                where b-grup-maquina.gm-codigo     = b-operacao.gm-codigo
                  and b-grup-maquina.log-principal = yes:
                 assign lg-considera = no.
                 leave.
             end. /* for each b-operacao */

             if lg-considera
             then disp stream st-relat
                       item.it-codigo
                       item.desc-item
                       with frame f-21.
        end. /* if first-of(operacao.it-codigo) */

        if not lg-considera
        then next. /* sem problemas usar break by + next neste caso */

        disp stream st-relat
             operacao.op-codigo
             operacao.descricao
             operacao.gm-codigo
             with frame f-21.
        down stream st-relat with frame f-21.
    end. /* for each operacao */

    output stream st-relat close.

    if valid-handle(h-wprog)
    then run OpenDocument in h-wprog (input c-arquivo). 

    return "OK".
end procedure. /* procedure pi-procedimento-21 */
