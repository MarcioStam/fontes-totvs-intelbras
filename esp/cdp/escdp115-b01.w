/* ************************  Function Implementations ***************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION fc-grupo B-table-Win 
FUNCTION fc-grupo RETURNS CHARACTER
  ( /* parameter-definitions */ ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
  ASSIGN v-grupo-cli = "".
  FOR FIRST gr-cli FIELDS(cod-gr-cli descricao) NO-LOCK 
      WHERE gr-cli.cod-gr-cli =  int-segmento-item.cod-gr-cli:
  END.
  IF AVAIL gr-cli THEN
     ASSIGN v-grupo-cli = gr-cli.descricao.

  RETURN v-grupo-cli.   /* Function return value. */

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION fc-segmento B-table-Win 
FUNCTION fc-segmento RETURNS CHARACTER
  ( /* parameter-definitions */ ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
ASSIGN v-segmento = "".
  FIND FIRST int-segmento-portifolio NO-LOCK 
       WHERE int-segmento-portifolio.cod-segmento = int-segmento-item.cod-segmento NO-ERROR.
  IF AVAIL int-segmento-portifolio THEN
     ASSIGN v-segmento = int-segmento-portifolio.descricao.

  RETURN v-segmento.  /* Function return value. */

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

