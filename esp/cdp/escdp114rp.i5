procedure pi-procedimento-05:
    def var lg-ferr-disp as logi no-undo.
    
    form tt-recurso.it-codigo     format "x(16)"   column-label "Item"
         tt-recurso.op-codigo     format ">>>>9"   column-label "Oper"
         tt-recurso.descricao     format "x(34)"   column-label "Descri‡Æo"
         tt-recurso.gm-codigo     format "x(9)"    column-label "Grupo Maq"
         tt-recurso.cod-ferr-prod format "x(16)"   column-label "Recurso"
         tt-recurso.obrigatoria   format "Sim/NÆo" column-label "Obrigat¢ria"
         tt-recurso.mensagem      format "x(40)"   column-label "Ocorrˆncia"
         with width 172 down no-box stream-io frame f-05.

    empty temp-table tt-recurso.

    assign i-cont         = 0
           c-arquivo      = tt-param.diretorio + "analise-grupos-rec.txt"
           c-titulo-relat = "Opera‡äes sem cadastro de Recurso Secund rio".

    if valid-handle(h-acomp)
    then do:
         run pi-seta-titulo in h-acomp (input "Opera‡äes sem cadastro de Recurso Secund rio...").
         run pi-acompanhar  in h-acomp (input 0).
    end.

    output stream st-relat to value(c-arquivo) paged page-size 64 convert target "iso8859-1".

    view stream st-relat frame f-cabec-172.
    view stream st-relat frame f-rodape-172.

    for each grup-maquina fields(gm-codigo log-2) no-lock,
        each operacao fields(num-id-operacao op-codigo descricao) use-index grup-maquina no-lock
       where operacao.gm-codigo     = grup-maquina.gm-codigo
         and operacao.data-termino >= today,
       first item fields(it-codigo) no-lock
       where item.it-codigo    = operacao.it-codigo
         and item.cod-obsoleto = 1:
        assign i-cont = i-cont + 1.

        if  i-cont mod 20 = 0
        and valid-handle(h-acomp)
        then run pi-acompanhar in h-acomp (input i-cont).

        for each int-gm-recurso no-lock
           where int-gm-recurso.gm-codigo = grup-maquina.gm-codigo:
            if can-find(first op-ferram where
                              op-ferram.num-id-operacao = operacao.num-id-operacao
                              no-lock)
            then next.

            create tt-recurso.
            assign tt-recurso.it-codigo     = item.it-codigo
                   tt-recurso.op-codigo     = operacao.op-codigo
                   tt-recurso.descricao     = operacao.descricao
                   tt-recurso.gm-codigo     = grup-maquina.gm-codigo
                   tt-recurso.cod-ferr-prod = int-gm-recurso.cod-ferr-prod
                   tt-recurso.obrigatoria   = int-gm-recurso.obrigatoria
                   tt-recurso.lg-oper       = yes
                   tt-recurso.mensagem      = "Falta o relacionamento na opera‡Æo".
        end. /* for each int-gm-recurso */

        if not grup-maquina.log-2
        then next.

        assign lg-ferr-disp = no.

        for each op-ferram fields(ferramenta) no-lock
           where op-ferram.num-id-operacao = operacao.num-id-operacao,
           first ferr-prod fields(char-1) no-lock
           where ferr-prod.cod-ferr-prod = op-ferram.ferramenta:
            if  trim(ferr-prod.char-1) <> "Ferramenta"
            and trim(ferr-prod.char-1) <> "Dispositivo"
            then next.

            assign lg-ferr-disp = yes.
            leave.
        end. /* for first ferr-prod */   

        if lg-ferr-disp
        then next.

        create tt-recurso.
        assign tt-recurso.it-codigo     = item.it-codigo
               tt-recurso.op-codigo     = operacao.op-codigo
               tt-recurso.descricao     = operacao.descricao
               tt-recurso.gm-codigo     = grup-maquina.gm-codigo
               tt-recurso.mensagem      = "Sem ferramenta-dispositivo p/ Gr M quina".
    end. /* for each grup-maquina */
    find current tt-recurso no-error.

    for each tt-recurso:
        assign i-cont = i-cont + 1.

        if  i-cont mod 50 = 0
        and valid-handle(h-acomp)
        then run pi-acompanhar in h-acomp (input i-cont).

        disp stream st-relat
             tt-recurso.it-codigo    
             tt-recurso.op-codigo    
             tt-recurso.descricao    
             tt-recurso.gm-codigo    
             tt-recurso.cod-ferr-prod
             tt-recurso.obrigatoria when tt-recurso.lg-oper
             tt-recurso.mensagem     
             with frame f-05.
        down stream st-relat with frame f-05.
    end. /* for each tt-recurso */

    output stream st-relat close.

    if valid-handle(h-wprog)
    then run OpenDocument in h-wprog (input c-arquivo). 

    return "OK".
end procedure. /* procedure pi-procedimento-05 */
