/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON bt-ajuda 
     LABEL "&Ajuda" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE BUTTON bt-cancela AUTO-END-KEY 
     LABEL "&Cancelar" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE BUTTON bt-ok AUTO-GO 
     LABEL "&OK" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE VARIABLE c-cta-fim AS CHARACTER FORMAT "9.9.9.99.999":U 
     VIEW-AS FILL-IN 
     SIZE 19 BY .88 NO-UNDO.

DEFINE VARIABLE c-cta-ini AS CHARACTER FORMAT "X.X.X.XX.XXX":U INITIAL "0.0.0.00.000" 
     LABEL "Conta" 
     VIEW-AS FILL-IN 
     SIZE 18.14 BY .88 NO-UNDO.

DEFINE IMAGE IMAGE-10
     FILENAME "image\im-las":U
     SIZE 3 BY .88.

DEFINE IMAGE IMAGE-9
     FILENAME "image\im-fir":U
     SIZE 3 BY .88.

DEFINE RECTANGLE rt-buttom
     EDGE-PIXELS 2 GRAPHIC-EDGE    
     SIZE 68 BY 1.42
     BGCOLOR 7 .


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME D-Dialog
     c-cta-ini AT ROW 2.5 COL 10 COLON-ALIGNED WIDGET-ID 4
     c-cta-fim AT ROW 2.54 COL 38.43 COLON-ALIGNED NO-LABEL WIDGET-ID 10
     bt-ok AT ROW 5.88 COL 2.43
     bt-cancela AT ROW 5.88 COL 13.43
     bt-ajuda AT ROW 5.88 COL 58.43
     rt-buttom AT ROW 5.63 COL 1.43
     IMAGE-9 AT ROW 2.54 COL 30.43 WIDGET-ID 30
     IMAGE-10 AT ROW 2.54 COL 37.14 WIDGET-ID 32
     SPACE(29.85) SKIP(3.82)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Parametros Consulta Or‡amento"
         DEFAULT-BUTTON bt-ok WIDGET-ID 100.


