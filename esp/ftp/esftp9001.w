/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

def input-output param c-unid-inicial as char no-undo.
def input-output param c-unid-final   as char no-undo.
def output param l-ok as logical.

/* Local Variable Definitions ---                                       */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartDialog
&Scoped-define DB-AWARE no

&Scoped-define ADM-CONTAINER DIALOG-BOX

/* Name of designated FRAME-NAME and/or first browse and/or first query */
&Scoped-define FRAME-NAME D-Dialog

/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS RECT-1 IMAGE-1 IMAGE-3 rt-buttom ~
c-inicial-unid c-final-unid bt-ok bt-cancela bt-ajuda 
&Scoped-Define DISPLAYED-OBJECTS c-inicial-unid c-final-unid 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON bt-ajuda 
     LABEL "&Ajuda" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE BUTTON bt-cancela AUTO-END-KEY 
     LABEL "&Cancelar" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE BUTTON bt-ok AUTO-GO 
     LABEL "&OK" 
     SIZE 10 BY 1
     BGCOLOR 8 .

DEFINE VARIABLE c-final-unid AS CHARACTER FORMAT "X(256)":U INITIAL "zzz" 
     VIEW-AS FILL-IN 
     SIZE 6.29 BY .88 NO-UNDO.

DEFINE VARIABLE c-inicial-unid AS CHARACTER FORMAT "X(256)":U 
     LABEL "Unid. Neg¢cio" 
     VIEW-AS FILL-IN 
     SIZE 6.29 BY .88 NO-UNDO.

DEFINE IMAGE IMAGE-1
     FILENAME "image\ii-fir":U
     SIZE 2.86 BY .92.

DEFINE IMAGE IMAGE-3
     FILENAME "image\ii-las":U
     SIZE 2.86 BY .92.

DEFINE RECTANGLE RECT-1
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 48.57 BY 2.75.

DEFINE RECTANGLE rt-buttom
     EDGE-PIXELS 2 GRAPHIC-EDGE    
     SIZE 48.57 BY 1.42
     BGCOLOR 7 .


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME D-Dialog
     c-inicial-unid AT ROW 1.63 COL 19.57 COLON-ALIGNED
     c-final-unid AT ROW 1.63 COL 36.72 COLON-ALIGNED NO-LABEL
     bt-ok AT ROW 4.29 COL 2.57
     bt-cancela AT ROW 4.29 COL 13.57
     bt-ajuda AT ROW 4.29 COL 38.57
     RECT-1 AT ROW 1.17 COL 1.57
     IMAGE-1 AT ROW 1.63 COL 30.14
     IMAGE-3 AT ROW 1.63 COL 35.86
     rt-buttom AT ROW 4.08 COL 1.57
     SPACE(0.57) SKIP(0.18)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Sele‡Æo de Notas"
         DEFAULT-BUTTON bt-ok.


/* *********************** Procedure Settings ************************ */

