{esp/ftp/esftp128.i}
{esp/es0018.i}
{utp/ut-glob.i}

DEFINE INPUT PARAMETER p-plp AS CHAR NO-UNDO.
DEFINE INPUT PARAMETER p-chave AS CHAR NO-UNDO.

RUN esp/ftp/esftp128rpd.p (INPUT p-plp,
                           OUTPUT TABLE ttPlp,
                           OUTPUT TABLE ttResumoServicos,
                           OUTPUT TABLE ttDocsExternos,  
                           OUTPUT TABLE ttDestinatario,  
                           OUTPUT TABLE ttRemetente,     
                           OUTPUT TABLE ttAwbs,          
                           OUTPUT TABLE ttItens).  

FOR EACH ttDocsExternos:
    RUN pi-imprime-etiqueta.
END.

PROCEDURE pi-imprime-etiqueta:

    DEF VAR c-cep-valid AS CHAR NO-UNDO.
    DEF VAR c-arquivo   AS CHAR NO-UNDO.

    DEFINE VARIABLE c-file     AS CHAR NO-UNDO.
    
    EMPTY TEMP-TABLE tt-prog-ponto.
    
    RUN esp/es0018p.p (INPUT  "WSO0003":U,
                       INPUT  8,
                       INPUT  0,
                       INPUT  "":U,
                       OUTPUT TABLE tt-prog-ponto).
    
    IF OPSYS = "UNIX":U THEN
        FOR FIRST tt-prog-ponto
            WHERE ENTRY(1,tt-prog-ponto.conteudo,";") = "UNIX":
            ASSIGN c-file = REPLACE(ENTRY(2,tt-prog-ponto.conteudo,";"), "~\":U, "/":U).
        END.
    ELSE
        FOR FIRST tt-prog-ponto
            WHERE ENTRY(1,tt-prog-ponto.conteudo,";") = "WIN":
            ASSIGN c-file = REPLACE(ENTRY(2,tt-prog-ponto.conteudo,";"), "~\":U, "/":U).
        END.
    
    FIND FIRST ttPlp NO-LOCK NO-ERROR.
    FIND FIRST ttResumoServicos NO-LOCK NO-ERROR.

    FIND FIRST ttDestinatario
         WHERE ttDestinatario.idm = ttDocsExternos.idm NO-LOCK NO-ERROR.
    FIND FIRST ttRemetente
         WHERE ttRemetente.idm = ttDocsExternos.idm NO-LOCK NO-ERROR.
    FIND FIRST ttAwbs
         WHERE ttAwbs.idm = ttDocsExternos.idm NO-LOCK NO-ERROR.
    FIND FIRST ttItens
         WHERE ttItens.idm = ttDocsExternos.idm NO-LOCK NO-ERROR.

    ASSIGN c-arquivo = c-file + p-chave + ".zpl".

    OUTPUT TO VALUE(c-arquivo).

