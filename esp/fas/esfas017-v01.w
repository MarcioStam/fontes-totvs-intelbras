     _Options          = "NO-LOCK"
     _Query            is NOT OPENED
*/  /* FRAME f-main */
&ANALYZE-RESUME

 


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK V-table-Win 


/* ***************************  Main Block  *************************** */

  &IF DEFINED(UIB_IS_RUNNING) <> 0 &THEN          
    RUN dispatch IN THIS-PROCEDURE ('initialize':U).        
  &ENDIF         

  ASSIGN v_usuar_aprov:SCREEN-VALUE IN FRAME {&FRAME-NAME} = v_cod_usuar_corren.

  FIND FIRST usuar_mestre
      WHERE usuar_mestre.cod_usuar = v_cod_usuar_corren NO-LOCK NO-ERROR.

  IF  AVAIL usuar_mestre THEN
      ASSIGN v_nom_usuario:SCREEN-VALUE IN FRAME {&FRAME-NAME} = usuar_mestre.nom_usuario.

/************************ INTERNAL PROCEDURES ********************/

