/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE VARIABLE v_nom_usuario AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 51 BY .88 NO-UNDO.

DEFINE VARIABLE v_usuar_aprov AS CHARACTER FORMAT "X(256)":U 
     LABEL "Usu rio" 
     VIEW-AS FILL-IN 
     SIZE 15 BY .88 NO-UNDO.

DEFINE RECTANGLE rt-key
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 84 BY 2.5.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME f-main
     v_usuar_aprov AT ROW 1.75 COL 14 COLON-ALIGNED WIDGET-ID 6
     v_nom_usuario AT ROW 1.75 COL 30 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     rt-key AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


