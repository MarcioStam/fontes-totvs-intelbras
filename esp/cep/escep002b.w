&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-carrega-tt w-cadsim 
PROCEDURE pi-carrega-tt :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

EMPTY TEMP-TABLE tt-int-item-fornec-estab.

FOR EACH mgesp.item-fabric no-lock
   where item-fabric.it-codigo = p-it-codigo:
    FOR FIRST item-fornec-estab NO-LOCK
        WHERE item-fornec-estab.it-codigo    = item-fabric.it-codigo
        AND   item-fornec-estab.item-do-forn = string(item-fabric.cod-fabric)
        AND   (item-fornec-estab.cod-estabel = p-cod-estabel OR p-cod-estabel = 'Todos'),
        FIRST int-item-fornec-estab OF item-fornec-estab:
        IF int-item-fornec-estab.log-nec-inspec THEN DO:
           FIND FIRST emitente NO-LOCK
                WHERE emitente.cod-emitente = int-item-fornec-estab.cod-emitente NO-ERROR.
           
           CREATE tt-int-item-fornec-estab.
           ASSIGN tt-int-item-fornec-estab.cod-estabel  = int-item-fornec-estab.cod-estabel 
                  tt-int-item-fornec-estab.cod-emitente = int-item-fornec-estab.cod-emitente
                  tt-int-item-fornec-estab.nome-abrev   = emitente.nome-abrev.
        END.
    END.
END.

{&open-query-br-fornec}

END PROCEDURE.

