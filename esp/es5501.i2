ASSIGN tt-totais.valor_rea{1}       = tt-totais.valor_rea{1} + tt-consulta-res.valor_rea{1}
       tt-totais.valor_orc{1}       = tt-totais.valor_orc{1} + tt-consulta-res.valor_orc{1} 
       tt-totais.de-var{1}          = IF tt-totais.valor_orc{1} > 0 AND tt-totais.valor_rea{1} > 0 THEN (tt-totais.valor_rea{1} / tt-totais.valor_orc{1}) * 100 ELSE 0       
       b-tt-totais.valor_rea{1}     = b-tt-totais.valor_rea{1} + tt-consulta-res.valor_rea{1}                                                                         
       b-tt-totais.valor_orc{1}     = b-tt-totais.valor_orc{1} + tt-consulta-res.valor_orc{1}                                                                         
       b-tt-totais.de-var{1}        = IF b-tt-totais.valor_orc{1} > 0 AND b-tt-totais.valor_rea{1} > 0 THEN (b-tt-totais.valor_rea{1} / b-tt-totais.valor_orc{1}) * 100 ELSE 0.
