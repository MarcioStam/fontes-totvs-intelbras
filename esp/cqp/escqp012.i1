        break by it-comp-exame.cod-exame:
        
        if last-of(it-comp-exame.cod-exame) then
            put unformatted it-comp-exame.descricao.
        else
            put unformatted it-comp-exame.descricao + ", ".
    end.
end.
else do:
    for each comp-exame where 
             comp-exame.cod-exame = exam-ficha.cod-exame
             no-lock
             break by comp-exame.cod-exame:       
             
        if last-of (comp-exame.cod-exame) then
           put unformatted comp-exame.descricao.      
