DEFINE TEMP-TABLE tt-tit_acr NO-UNDO
    FIELD cod_modul              AS CHARACTER
    FIELD cod_estab              LIKE tit_acr.cod_estab
    FIELD cdn_clien_fornec       LIKE tit_acr.cdn_cliente
    FIELD cod_espec_docto        LIKE tit_acr.cod_espec_docto
    FIELD cod_ser_docto          LIKE tit_acr.cod_ser_docto
    FIELD cod_tit                LIKE tit_acr.cod_tit_acr
    FIELD cod_parcela            LIKE tit_acr.cod_parcela
    FIELD cod_unid_negoc         LIKE val_tit_acr.cod_unid_negoc
    FIELD num_id_tit             LIKE tit_acr.num_id_tit
    FIELD cdn_repres             LIKE tit_acr.cdn_repres
    FIELD ind_tip_espec_docto    LIKE tit_acr.ind_tip_espec_docto
    FIELD dat_emis_docto         LIKE tit_acr.dat_emis_docto
    FIELD dat_vencto_origin_tit  LIKE tit_acr.dat_vencto_origin_tit
    FIELD dat_vencto_tit         LIKE tit_acr.dat_vencto_tit
    FIELD dat_indcao_perda_dedut LIKE tit_acr.dat_indcao_perda_dedut
    FIELD dat_ult_liquidac_tit   LIKE tit_acr.dat_ult_liquidac_tit
    FIELD cod_indic_econ         LIKE tit_acr.cod_indic_econ
    FIELD val_origin_tit         LIKE val_tit_acr.val_origin_tit
    FIELD val_sdo_tit            LIKE val_tit_acr.val_sdo_tit
    FIELD log_tit_estordo        LIKE tit_acr.log_tit_acr_estordo
    FIELD log_sdo_tit            LIKE tit_acr.log_sdo_tit
    FIELD log_tit_acr_cobr_bcia  LIKE tit_acr.log_tit_acr_cobr_bcia
    FIELD cod_portador           LIKE tit_acr.cod_portador
    FIELD cod_cart_bcia          LIKE tit_acr.cod_cart_bcia
    FIELD cod_tit_acr_bco        LIKE tit_acr.cod_tit_acr_bco
    FIELD new_name               AS CHARACTER
    FIELD new_chaveintegracao    AS CHARACTER.

DEFINE TEMP-TABLE tt-tit_ap NO-UNDO
    FIELD cod_modul              AS CHARACTER
    FIELD cod_estab              LIKE tit_ap.cod_estab
    FIELD cdn_clien_fornec       LIKE tit_ap.cdn_fornecedor
    FIELD cod_espec_docto        LIKE tit_ap.cod_espec_docto
    FIELD cod_ser_docto          LIKE tit_ap.cod_ser_docto
    FIELD cod_tit                LIKE tit_ap.cod_tit_ap
    FIELD cod_parcela            LIKE tit_ap.cod_parcela
    FIELD cod_unid_negoc         LIKE val_tit_ap.cod_unid_negoc
    FIELD num_id_tit             LIKE tit_ap.num_id_tit
    FIELD ind_tip_espec_docto    LIKE tit_ap.ind_tip_espec_docto
    FIELD dat_emis_docto         LIKE tit_ap.dat_emis_docto
    FIELD dat_vencto_tit         LIKE tit_ap.dat_vencto_tit
    FIELD dat_ult_liquidac_tit   LIKE tit_ap.dat_liquidac_tit_ap
    FIELD cod_indic_econ         LIKE tit_ap.cod_indic_econ
    FIELD val_origin_tit         LIKE val_tit_ap.val_origin_tit
    FIELD val_sdo_tit            LIKE val_tit_ap.val_sdo_tit
    FIELD log_tit_estordo        LIKE tit_ap.log_tit_ap_estordo
    FIELD log_sdo_tit            LIKE tit_ap.log_sdo_tit
    FIELD cod_portador           LIKE tit_ap.cod_portador
    FIELD new_name               AS CHARACTER
    FIELD new_chaveintegracao    AS CHARACTER.
