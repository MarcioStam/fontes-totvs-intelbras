&Scoped-define FRAME-NAME fPage2
&Scoped-define SELF-NAME FCliente
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL FCliente wReport
ON LEAVE OF FCliente IN FRAME fPage2 /* Cliente */
DO:
  FIND FIRST emitente NO-LOCK 
       WHERE emitente.cod-emitente = int(INPUT FRAME fpage2 FCliente) 
       AND   emitente.cod-emitente <> 0 NO-ERROR.
  IF NOT AVAIL emitente THEN DO:
      FIND FIRST emitente NO-LOCK 
           WHERE emitente.nome-abrev = INPUT FRAME fpage2 FCliente 
           AND   emitente.nome-abrev <> "uso interno" NO-ERROR.
  END.
  IF AVAIL emitente THEN
      DISP emitente.nome-abrev @ fcliente WITH FRAME fpage2.
  
  FIND emitente-cex
       where emitente-cex.cod-emitente = emitente.cod-emitente no-lock no-error.
  if avail emitente-cex then do:
     assign c-incoterm:screen-value in frame fpage2 = emitente-cex.cod-incoterm-exp.
  end.
  
  find int-emitente-cex
       where int-emitente-cex.cod-emitente = emitente.cod-emitente no-lock no-error.
  if avail int-emitente-cex then
     assign c-local-embarque:screen-value in frame fpage2 = int-emitente-cex.local-embarque
            c-embarque-via:screen-value in frame fpage2 = int-emitente-cex.embarque-via.
  
END.

