  correta dos componentes do RTF quando executado em ambiente local e no WebEnabler.*/
&IF "{&RTF}":U = "YES":U &THEN
IF VALID-HANDLE(hWenController) THEN DO:
    ASSIGN l-habilitaRtf:sensitive IN FRAME fPage6 = NO
           l-habilitaRtf:SCREEN-VALUE IN FRAME fPage6 = "No"
           l-habilitaRtf = NO.
           
END.
RUN pi-habilitaRtf.
&endif

ASSIGN c-texto = "* Apenas Ordens de produá∆o com status de Finalizada e Terminada ser∆o consideradas "
               + CHR(13) + "  na atualizaá∆o de GGF." 
               + CHR(13)
               + "* Os usu†rios abaixo est∆o liberados para executar fora do per°odo fechado: "
               + CHR(13).

RUN esp/es0018p.p (INPUT "ESCPP047":U,
                   INPUT 1,
                   INPUT 0,
                   INPUT "":U,
                   OUTPUT TABLE tt-prog-ponto).
    
FOR EACH tt-prog-ponto NO-LOCK.
    ASSIGN c-texto = c-texto + "  " + tt-prog-ponto.conteudo + CHR(13).
END.

assign fi-data-ini:screen-value in frame fPage2  = string(today)
       fi-data-fim:screen-value in frame fPage2  = string(today)
       ed-descricao:screen-value in frame fPage2 = c-texto.
       
/*Fim alteracao 17/02/2005*/

END PROCEDURE.

