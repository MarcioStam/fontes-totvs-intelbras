/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE pi-processa wWindow 
PROCEDURE pi-processa :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE VARIABLE h-boes655 AS HANDLE      NO-UNDO.


    RUN esbo/boes655.p PERSISTENT SET h-boes655.

    FOR EACH familia NO-LOCK
        WHERE familia.fm-codigo >= INPUT FRAME fpage0 fi-fm-codigo-ini
        AND   familia.fm-codigo <= INPUT FRAME fpage0 fi-fm-codigo-fim:

        FOR EACH ITEM NO-LOCK
            WHERE ITEM.fm-codigo = familia.fm-codigo:

            IF NOT CAN-FIND(FIRST item-falha
                            WHERE item-falha.it-codigo = ITEM.it-codigo
                            AND   item-falha.cod-falha = INPUT FRAME fPage0 fi-cod-falha) THEN DO:

                EMPTY TEMP-TABLE tt-item-falha.
                
                CREATE tt-item-falha.
                ASSIGN tt-item-falha.it-codigo = ITEM.it-codigo
                       tt-item-falha.cod-falha = INPUT FRAME fPage0 fi-cod-falha.

                RUN emptyRowErrors IN h-boes655 NO-ERROR.        
                RUN openQueryStatic IN h-boes655 (INPUT "Main":U) NO-ERROR.
                RUN setrecord IN h-boes655 (INPUT TABLE tt-item-falha).  
                RUN createrecord IN h-boes655.
                RUN getRowErrors IN h-boes655 (OUTPUT TABLE RowErrors).
                
                IF CAN-FIND(FIRST RowErrors) THEN DO:

                    {METHOD/showmessage.i1}
                    {METHOD/showmessage.i2 &Modal="YES"}
                
                END.
                
            END.

        END.

    END.
    

END PROCEDURE.

