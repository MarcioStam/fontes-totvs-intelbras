&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS Include 
/*------------------------------------------------------------------------
    File        : ESSDCV001API.I1
    Purpose     : Integra‡Æo do ERP TOTVS/Datasul EMS 2 com o OutBuyCenter
                  (Defini‡Æo dos principais m‚todos da API).
    Syntax      : <none>
    Description : <none>

    Author(s)   : Fabiano Sakae Ribeiro (Exponencial TI)
    Created     : Julho de 2013
    Notes       : <none>
----------------------------------------------------------------------*/

/* ***************************  Definitions  ************************** */

/* Local Temp-Table Definitions ---                                     */

DEFINE TEMP-TABLE ttRegistro NO-UNDO
    FIELD sequencia AS INTEGER   FORMAT ">>>,>>9":U LABEL "Sequˆncia":U COLUMN-LABEL "Seq":U
    FIELD tabela    AS CHARACTER FORMAT "x(40)":U   LABEL "Tabela":U    COLUMN-LABEL "Tabela":U
    FIELD id        AS CHARACTER FORMAT "x(80)":U   LABEL "Id":U        COLUMN-LABEL "Id":U
    FIELD registro  AS CHARACTER FORMAT "x(256)":U  LABEL "Registro":U  COLUMN-LABEL "Registro":U
    INDEX chPrimario IS PRIMARY UNIQUE
        sequencia
    INDEX chTabela
        tabela
        sequencia
    INDEX chId
        id
        tabela
        sequencia.

/* Local Variable Definitions ---                                       */

DEFINE NEW GLOBAL SHARED VARIABLE gc-plano AS CHARACTER NO-UNDO.
DEFINE NEW GLOBAL SHARED VARIABLE gc-ccusto AS CHARACTER NO-UNDO.

/* Vari veis de conexÆo com o Web Service */
DEFINE VARIABLE vWSDL      AS CHARACTER   NO-UNDO.
DEFINE VARIABLE vPORTTYPE  AS CHARACTER   NO-UNDO.
DEFINE VARIABLE vOPERATION AS CHARACTER   NO-UNDO.

/* Handle de conexÆo com o Web Service */
DEFINE VARIABLE hServer   AS HANDLE      NO-UNDO.
DEFINE VARIABLE hPortType AS HANDLE      NO-UNDO.

/* Contador de erros do "ERROR-STATUS" */
DEFINE VARIABLE iContErroStatus AS INTEGER     NO-UNDO.

/* Vari vel para guardar o registro antes do envio */
DEFINE VARIABLE cRegistro AS CHARACTER   NO-UNDO.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */



/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



