/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE AfterInitializeInterface wWindow 
PROCEDURE AfterInitializeInterface :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DO WITH FRAME fPage0:
       ASSIGN ITEM.it-codigo:SENSITIVE  = NO
              ITEM.desc-item:SENSITIVE  = NO
              fiQuantidade:SCREEN-VALUE = string(pQuantidade).
       DISP ITEM.it-codigo
            ITEM.desc-item.
       APPLY "ENTRY" TO fiQuantidade. 
    END.

    RETURN "OK":U.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE BeforeInitializeInterface wWindow 
PROCEDURE BeforeInitializeInterface :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    FOR FIRST ITEM FIELDS(it-codigo desc-item) NO-LOCK 
        WHERE ITEM.it-codigo = pItCodigo:
    END.

    RETURN "OK":U.

END PROCEDURE.

