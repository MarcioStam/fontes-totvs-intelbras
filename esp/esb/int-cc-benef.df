ADD INDEX "idx-status" ON "int-cc-benef" 
  AREA "dados64x8"
  INDEX-FIELD "id-status" ASCENDING 
  INDEX-FIELD "tipo-beneficio" ASCENDING 
  INDEX-FIELD "unid-neg" ASCENDING 

ADD INDEX "idx-canal-status" ON "int-cc-benef" 
  AREA "dados64x8"
  INDEX-FIELD "id-status" ASCENDING 
  INDEX-FIELD "canal" ASCENDING 
  INDEX-FIELD "tipo-beneficio" ASCENDING 
  INDEX-FIELD "unid-neg" ASCENDING 

ADD INDEX "idx-primary" ON "int-cc-benef" 
  AREA "dados64x8"
  UNIQUE
  PRIMARY
  INDEX-FIELD "tp-movto" ASCENDING 
  INDEX-FIELD "canal" ASCENDING 
  INDEX-FIELD "unid-neg" ASCENDING 
  INDEX-FIELD "tipo-beneficio" ASCENDING 
  INDEX-FIELD "dt-periodo-ini" ASCENDING 
  INDEX-FIELD "dt-periodo-fim" ASCENDING 

ADD INDEX "idx-titulo-ap" ON "int-cc-benef" 
  AREA "dados64x8"
  INDEX-FIELD "cod_estab" ASCENDING 
  INDEX-FIELD "num_id_tit_ap" ASCENDING 

