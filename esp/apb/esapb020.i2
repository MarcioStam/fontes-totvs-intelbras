END.

/*************************** Trigger Definition End *************************/

/************************** Main Code Begin *********************************/

filter_block:
DO ON ERROR UNDO filter_block, RETRY filter_block
                 ON ENDKEY UNDO filter_block, LEAVE filter_block:

     IF SESSION:SET-WAIT-STATE('general') THEN.

     RUN esp/apb/esapb020-api.p PERSISTENT SET h-esapb020-api.
     
     EMPTY TEMP-TABLE tt_log_erros_tit_ap_alteracao.
     EMPTY TEMP-TABLE tt_log_erros_atualiz.
     EMPTY TEMP-TABLE tt_concil.

     RUN pi-inicializar IN h-esapb020-api (INPUT v_cod_empres_usuar,
                                           INPUT v_cod_estab_usuar, 
                                           INPUT rs-conciliacao,
                                           INPUT dt-pagto,
                                           INPUT de-val-max-ava,
                                           INPUT c-conta-ava,
                                           input de-val-min-parcial,
                                           OUTPUT TABLE tt_concil).
     IF SESSION:SET-WAIT-STATE('') THEN.

     VIEW FRAME f_comiss_det.

     concil_block:
     DO ON ERROR UNDO concil_block, RETRY concil_block
                      ON ENDKEY UNDO concil_block, LEAVE concil_block:

          ENABLE ALL WITH FRAME f_comiss_det.

          OPEN QUERY qr_tt_concil
               FOR EACH tt_concil NO-LOCK.

          WAIT-FOR GO OF FRAME f_comiss_det.

/*
          EMPTY TEMP-TABLE tt_log_erros_tit_ap_alteracao.
          EMPTY TEMP-TABLE tt_log_erros_atualiz.
          
          RUN pi_atualizar IN h-esapb020-api.
*/

          IF  VALID-HANDLE(h-esapb020-api)
          THEN DO:
              DELETE PROCEDURE h-esapb020-api.
              ASSIGN h-esapb020-api = ?.
          END.
     END.

     HIDE FRAME f_comiss_det.
END.


