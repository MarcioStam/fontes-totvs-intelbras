/*               FOR EACH btt_concil                                                                */
/*                   WHERE btt_concil.num_id_tt_concil = tt_concil.num_id_tt_concil:                */
/*                   IF btt_concil.cod_tip_reg = 3                                                  */
/*                   OR btt_concil.cod_tip_reg = 4                                                  */
/*                      THEN NEXT.                                                                  */
/*                   ASSIGN btt_concil.log_conf = v_log_status.                                     */
/*               END.                                                                               */
/*          END.                                                                                    */
/*          IF tt_concil.cod_tip_reg = 2 /* ** Duplicata - inverte sinal ***/                       */
/*          THEN DO:                                                                                */
/*               ASSIGN tt_concil.log_conf = NOT(tt_concil.log_conf).                               */
/*          END.                                                                                    */
/*                                                                                                  */
/*          /* ** Totaliza Abatimento ***/                                                          */
/*          FOR EACH btt_concil                                                                     */
/*              WHERE btt_concil.num_id_tt_concil = tt_concil.num_id_tt_concil                      */
/*                AND btt_concil.log_conf:                                                          */
/*              IF btt_concil.cod_tip_reg = 1                                                       */
/*                 THEN ASSIGN v_val_sdo = v_val_sdo - btt_concil.val_sdo.                          */
/*              IF btt_concil.cod_tip_reg = 2                                                       */
/*                 THEN ASSIGN v_val_sdo = v_val_sdo + btt_concil.val_sdo.                          */
/*          END.                                                                                    */
/*          FIND btt_concil                                                                         */
/*             WHERE btt_concil.num_id_tt_concil = tt_concil.num_id_tt_concil                       */
/*               AND btt_concil.cod_tip_reg      = 3.                                               */
