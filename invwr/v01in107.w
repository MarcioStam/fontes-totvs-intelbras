&Scoped-define SELF-NAME supervisor.cod-usuario
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL supervisor.cod-usuario V-table-Win
ON F5 OF supervisor.cod-usuario IN FRAME f-main /* C¢digo Usu rio */
DO:
  assign l-implanta = yes.
   {include/zoomvar.i &prog-zoom=unzoom/z01un178.w
                      &campo=supervisor.cod-usuario
                      &campozoom=cod_usuario}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL supervisor.cod-usuario V-table-Win
ON LEAVE OF supervisor.cod-usuario IN FRAME f-main /* C¢digo Usu rio */
DO:
  find usuar_mestre where usuar_mestre.cod_usuario = input supervisor.cod-usuario:SCREEN-VALUE in frame {&FRAME-NAME} no-lock no-error.
    If not Available(usuar_mestre) then do:                            
         supervisor.nome-supervisor:screen-value in frame {&FRAME-NAME} = "".
         MESSAGE "Informar um usu rio v lido."
             VIEW-AS ALERT-BOX INFO BUTTONS OK.
         Apply "entry" to supervisor.cod-usuario.
         RETURN NO-APPLY.
         
    End.
    else do:
        supervisor.nome-supervisor:screen-value in frame {&FRAME-NAME} = usuar_mestre.nom_usuario.
    end.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL supervisor.cod-usuario V-table-Win
ON MOUSE-SELECT-DBLCLICK OF supervisor.cod-usuario IN FRAME f-main /* C¢digo Usu rio */
DO:
  APPLY 'F5' TO SELF.
END.

