PROCEDURE AfterInitializeInterface :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
   for each tt-pedido-pd0802:
       assign c-nr-pedcli:screen-value in frame fpage1 = c-nr-pedcli:screen-value in frame fpage1 + "," +
                                                         tt-pedido-pd0802.nr-pedcli.
   end.

   assign c-nr-pedcli:sensitive in frame fpage1 = no.
END PROCEDURE.

